SECRET_KEY=
DATABASE_URL=sqlite:///mathverse.db
GEMINI_API_KEY=
# gemini-2.5-pro is retired for new API keys, and the pro/preview tiers need
# paid quota -- 2.5-flash works on the free tier and is fast enough here.
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- TTS fallback ---------------------------------------------------------
# Used automatically when ElevenLabs is missing, invalid, or out of quota.
#   edge = free Microsoft neural voices via edge-tts (no API key, needs net)
#   none = no fallback; failures produce a silent video
TTS_FALLBACK_PROVIDER=edge
# Any Edge neural voice. List them with:  edge-tts --list-voices
# e.g. en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural, en-IN-NeerjaNeural
TTS_FALLBACK_VOICE=en-US-AriaNeural
MEDIA_ROOT=./media
MANIM_QUALITY=high_quality
MAX_RENDER_SECONDS=180
MAX_REPAIR_ATTEMPTS=3
GUEST_DAILY_VIDEOS=5
USER_DAILY_VIDEOS=25
GUEST_DAILY_WHITEBOARD=40
USER_DAILY_WHITEBOARD=200
FLASK_ENV=development
FLASK_APP=wsgi.py
